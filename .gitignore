
# IT Toolkit
# Keep the Reports folder, but ignore generated reports
Reports/*
!Reports/.gitkeep

# Ignore snapshot files anywhere in the repository
*.snapshot.json

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.old
*.swp
*~

# PowerShell transcripts
*transcript*.txt

# Editor and IDE settings
.vscode/
.idea/
.vs/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Development and testing output
TestResults/
coverage/

# Local configuration backups
Toolkit-config.local.json
Toolkit-config.*.backup.json

# Credentials and sensitive exports
*.credential.xml
*.clixml
*.pfx
*.key
